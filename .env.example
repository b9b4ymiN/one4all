# API Keys for Real-LLM Testing
# Copy this file to .env.local and fill in your actual API keys
# These keys are required for running real-LLM integration tests

# Anthropic API Key
# Required for Claude provider real-LLM tests
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
# Required for ZAI provider real-LLM tests
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API Key
# Required for Gemini provider real-LLM tests
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Test Configuration Flags
# Set these to enable specific real-LLM test suites
# TEST_CLAUDE_REAL=1
# TEST_ZAI_REAL=1
# TEST_GEMINI_REAL=1

# Local Testing Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Add your actual API keys
# 3. Run specific tests: npm run test:real:claude
# 4. Run all real-LLM tests: npm run test:real-llm

# Note: Never commit .env.local or any file containing actual API keys
# The .env.local file is git-ignored by default
